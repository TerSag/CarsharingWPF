<Window x:Class="CarsharingWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інформаційна платформа каршерінгу"
        Height="650" Width="1050"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Автопарк"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Керування автомобілями інформаційної платформи каршерінгу"
                       FontSize="14"
                       Foreground="DimGray"
                       Margin="0,4,0,0"/>
            <Button Content="Клієнти"
                    Width="120"
                    Height="34"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Click="OpenClients_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Пошук"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Padding="8,4"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Доступність"
                           Margin="0,0,0,4"/>

                <ComboBox ItemsSource="{Binding AvailabilityFilters}"
                          SelectedItem="{Binding SelectedAvailabilityFilter}"
                          Height="32"
                          Padding="6,3"/>
            </StackPanel>
        </Grid>
        
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding CarsView}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="34"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Рік" Binding="{Binding Year}" Width="90"/>
                <DataGridTextColumn Header="Держ. номер" Binding="{Binding LicensePlate}" Width="140"/>
                <DataGridTextColumn Header="Ціна (грн/год)" Binding="{Binding PricePerHour}" Width="140"/>
                <DataGridCheckBoxColumn Header="Доступна" Binding="{Binding IsAvailable}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                           Text="Дані автомобіля"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Марка" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="6,3"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Модель" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="6,3"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4">
                    <TextBlock Text="Рік випуску" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="6,3"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                    <TextBlock Text="Державний номер" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="6,3"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="Ціна за годину, грн" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PricePerHour, UpdateSourceTrigger=PropertyChanged}"
                             Height="30" Padding="6,3"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,12,0,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Автомобіль доступний"
                              IsChecked="{Binding IsAvailable}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Очистити"
                    Command="{Binding ClearCommand}"
                    Width="110" Height="36"
                    Margin="0,0,8,0"/>
            <Button Content="Додати"
                    Command="{Binding AddCommand}"
                    Width="110" Height="36"
                    Margin="0,0,8,0"/>
            <Button Content="Зберегти зміни"
                    Command="{Binding UpdateCommand}"
                    Width="140" Height="36"
                    Margin="0,0,8,0"/>
            <Button Content="Видалити"
                    Command="{Binding DeleteCommand}"
                    Width="110" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
