<Window x:Class="CarsharingWPF.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування клієнтами"
        Height="600"
        Width="900"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Клієнти"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Керування клієнтами інформаційної платформи каршерінгу"
                       FontSize="14"
                       Foreground="DimGray"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <!-- Таблиця клієнтів -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ClientsList}"
                  SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  RowHeight="34"
                  Margin="0,0,0,15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Ім'я"
                                    Binding="{Binding FirstName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Прізвище"
                                    Binding="{Binding LastName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding Phone}"
                                    Width="180"/>

                <DataGridTextColumn Header="Водійське посвідчення"
                                    Binding="{Binding DriverLicense}"
                                    Width="200"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Форма -->
        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="3"
                           Text="Дані клієнта"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="0">

                    <TextBlock Text="Ім'я"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="6,3"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="2">

                    <TextBlock Text="Прізвище"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="6,3"/>

                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,12,0,0">

                    <TextBlock Text="Телефон"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="6,3"/>

                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,12,0,0">

                    <TextBlock Text="Водійське посвідчення"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding DriverLicense, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             Padding="6,3"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Очистити"
                    Command="{Binding ClearCommand}"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"/>

            <Button Content="Додати"
                    Command="{Binding AddCommand}"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"/>

            <Button Content="Зберегти зміни"
                    Command="{Binding UpdateCommand}"
                    Width="140"
                    Height="36"
                    Margin="0,0,8,0"/>

            <Button Content="Видалити"
                    Command="{Binding DeleteCommand}"
                    Width="110"
                    Height="36"/>

        </StackPanel>

    </Grid>
</Window>