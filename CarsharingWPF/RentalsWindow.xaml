<Window x:Class="CarsharingWPF.RentalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування орендами"
        Height="650"
        Width="1000"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Оренди"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Керування орендами автомобілів"
                       FontSize="14"
                       Foreground="DimGray"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <!-- Створення оренди -->
        <Border Grid.Row="1"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Клієнт -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Клієнт"
                               Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding ClientsList}"
                              SelectedItem="{Binding SelectedClient}"
                              DisplayMemberPath="FullName"
                              Height="32"
                              Padding="6,3"/>

                </StackPanel>

                <!-- Автомобіль -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Автомобіль"
                               Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding AvailableCarsList}"
                              SelectedItem="{Binding SelectedCar}"
                              Height="32"
                              Padding="6,3">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Brand}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Model}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding LicensePlate}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </StackPanel>

                <!-- Початок оренди -->
                <Button Grid.Column="4"
                        Content="Розпочати оренду"
                        Command="{Binding StartRentalCommand}"
                        Width="170"
                        Height="36"
                        VerticalAlignment="Bottom"/>

            </Grid>

        </Border>

        <!-- Фільтр -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,10">

            <TextBlock Text="Показати:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox ItemsSource="{Binding RentalFilters}"
                      SelectedItem="{Binding SelectedRentalFilter}"
                      Width="150"
                      Height="30"/>

        </StackPanel>

        <!-- Таблиця оренд -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding RentalsView}"
                  SelectedItem="{Binding SelectedRental, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="34">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Клієнт"
                                    Binding="{Binding Client.FullName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTextColumn Header="Автомобіль"
                                    Binding="{Binding Car.Brand}"
                                    Width="140"/>

                <DataGridTextColumn Header="Модель"
                                    Binding="{Binding Car.Model}"
                                    Width="140"/>

                <DataGridTextColumn Header="Номер"
                                    Binding="{Binding Car.LicensePlate}"
                                    Width="140"/>

                <DataGridTextColumn Header="Початок"
                                    Binding="{Binding StartTime,
                                             StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="160"/>

                <DataGridTextColumn Header="Завершення"
                                    Binding="{Binding EndTime,
                                             StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="160"/>

                <DataGridTextColumn Header="Вартість"
                                    Binding="{Binding TotalPrice}"
                                    Width="110"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Завершення оренди -->
        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,12,0,0">

            <Button Content="Очистити історію"
            Command="{Binding ClearHistoryCommand}"
            Width="160"
            Height="36"
            Margin="0,0,10,0"/>

            <Button Content="Завершити оренду"
            Command="{Binding EndRentalCommand}"
            Width="170"
            Height="36"/>

        </StackPanel>

    </Grid>
</Window>