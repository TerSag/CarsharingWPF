<Window x:Class="CarsharingWPF.RentalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування орендами"
        Width="1100"
        Height="720"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">

    <Window.Resources>

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="6,3"/>
            <Setter Property="BorderBrush"
                    Value="#C8CED8"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="BorderBrush"
                    Value="#C8CED8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="MinWidth"
                    Value="145"/>
            <Setter Property="Padding"
                    Value="16,0"/>
            <Setter Property="Margin"
                    Value="8,0,0,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock Text="Оренди"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Керування активними та завершеними орендами"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDE2EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Клієнт"
                               FontSize="13"
                               Foreground="#4B5563"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding ClientsList}"
                              SelectedItem="{Binding SelectedClient}"
                              DisplayMemberPath="FullName"
                              Style="{StaticResource InputComboBoxStyle}"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="Автомобіль"
                               FontSize="13"
                               Foreground="#4B5563"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding AvailableCarsList}"
                              SelectedItem="{Binding SelectedCar}"
                              Style="{StaticResource InputComboBoxStyle}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Brand}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Model}"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding LicensePlate}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                </StackPanel>

                <Button Grid.Column="4"
                        Content="Розпочати оренду"
                        Command="{Binding StartRentalCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0"
                        VerticalAlignment="Bottom"/>

            </Grid>

        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Пошук"
                           FontSize="13"
                           Foreground="#4B5563"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}"/>

            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Статус оренди"
                           FontSize="13"
                           Foreground="#4B5563"
                           Margin="0,0,0,5"/>

                <ComboBox ItemsSource="{Binding RentalFilters}"
                          SelectedItem="{Binding SelectedRentalFilter}"
                          Style="{StaticResource InputComboBoxStyle}"/>

            </StackPanel>

        </Grid>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#DDE2EA"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,16">

            <DataGrid ItemsSource="{Binding RentalsView}"
                      SelectedItem="{Binding SelectedRental, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      AlternatingRowBackground="#F9FAFB">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Клієнт"
                                        Binding="{Binding Client.FullName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Марка"
                                        Binding="{Binding Car.Brand}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Модель"
                                        Binding="{Binding Car.Model}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Номер"
                                        Binding="{Binding Car.LicensePlate}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Початок"
                                        Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Завершення"
                                        Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Вартість"
                                        Binding="{Binding TotalPrice}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Очистити історію"
                    Command="{Binding ClearHistoryCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="160"/>

            <Button Content="Завершити оренду"
                    Command="{Binding EndRentalCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="165"/>

        </StackPanel>

    </Grid>

</Window>